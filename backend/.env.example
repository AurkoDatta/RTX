PORT=4000
NODE_ENV=development

# Local Postgres (native Homebrew service, database created via `createdb raytracer_dev`).
DATABASE_URL=postgres://localhost:5432/raytracer_dev

# Generate a real secret for local dev with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Vite dev server origin, for CORS.
CORS_ORIGIN=http://localhost:5173

# Path to the built renderer binary, relative to backend/ or absolute.
RENDERER_BINARY_PATH=../renderer/target/release/renderer
